{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "strategy-formalizer term file",
  "description": "EN: Term set carried from S2 to final/. Terms are never deleted, only status=dropped. json is the source of truth; xlsx is generated by sf_terms.py. | 中文：从 S2 一路传递到 final/ 的术语集。术语只标记 dropped 不删除。json 为真值，xlsx 由 sf_terms.py 生成。",
  "type": "object",
  "required": ["stage", "terms"],
  "properties": {
    "stage": {"type": "string", "pattern": "^S[1-8]$"},
    "scheme_id": {"type": ["string", "null"]},
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name_zh", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^T\\d{3,}$", "description": "stable id / 稳定 id"},
          "name_zh": {"type": "string", "description": "canonical Chinese name, bolded in summary if callback / 中文规范名"},
          "name_en": {"type": "string", "pattern": "^([a-z][a-z0-9_]*)?$", "description": "snake_case, becomes the callback name / 用作回调函数名"},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["candidate", "kept", "dropped", "defined"]},
          "role": {"enum": ["callback", "parameter", "constraint", "aux_note", "scope", null]},
          "phase": {"enum": ["market_context", "entry", "position_mgmt", "exit", "risk", "philosophy", null]},
          "is_key": {"type": "boolean", "description": "derived: role == callback / 派生列"},
          "source_quote": {"type": "string"},
          "definition_zh": {"type": "string"},
          "definition_en": {"type": "string"},
          "supports": {"type": "array", "items": {"type": "string", "pattern": "^T\\d{3,}$"}, "description": "key terms this term explains / 所说明的关键术语"},
          "appears_in": {"type": "array", "items": {"enum": ["summary", "one_liner", "premise", "execution_steps", "exit_and_risk", "scope_and_params"]}},
          "origin": {"enum": ["S2_extract", "S3_dialog", "S4_filter", "S5_classify", "S6_dialog", "user_edit"]},
          "drop_reason": {"type": "string"},
          "notes": {"type": "string"},
          "history": {"type": "array", "items": {"type": "object"}}
        }
      }
    }
  }
}
